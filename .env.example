# LLM Provider: 'claude' or 'gemini'
LLM_PROVIDER=gemini

# Claude (Anthropic) — required if LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini (Google) — required if LLM_PROVIDER=gemini and not using Vertex AI
# GOOGLE_API_KEY=AIza...

# Database path (default: ./data/scoring.db for Docker, ./scoring.db for local)
# SCORING_DB_PATH=./data/scoring.db

# JWT secret for authentication — generate a random string for production
JWT_SECRET=change-me-in-production

# GCP settings (only needed for Vertex AI batch scoring)
# GCP_PROJECT=your-gcp-project
# GCP_LOCATION=us-central1
# GCS_BATCH_BUCKET=your-batch-bucket
